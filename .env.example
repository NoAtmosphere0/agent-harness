# Copy to .env and adjust. All values shown are the defaults.

# --- LLM -------------------------------------------------------------------
# scripted = replay a canned script, no API key needed; openai_compat = real model
LLM_PROVIDER=scripted
# OpenAI: https://api.openai.com/v1   Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Send parallel_tool_calls=false; disable for providers that reject the field
LLM_SEND_PARALLEL_TOOL_CALLS_FLAG=true

# --- Execution limits --------------------------------------------------------
MAX_STEPS=12
# Active time only; time spent waiting for approval is not counted
MAX_RUN_SECONDS=120
MAX_PARSE_RETRIES=2
MAX_CONSECUTIVE_TOOL_ERRORS=3
REPEAT_CALL_LIMIT=3

# --- Tools -------------------------------------------------------------------
TOOL_MAX_RETRIES=2
OBSERVATION_MAX_CHARS=4000

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./harness.db
DATA_DIR=./data

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- Mock tools / fault injection -------------------------------------------
# JSON, e.g. {"get_service_status": {"mode": "flaky", "fail_times": 2}}
MOCK_FAULTS={}
# Allow per-run config_overrides.faults through the API
ALLOW_FAULT_OVERRIDES=true
MOCK_SEED=42
