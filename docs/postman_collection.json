            "description": "Blocks until the run finishes or pauses for approval (≤ 60 s).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objective\": \"Customers are reporting failed checkouts. Investigate checkout-api and open an incident if it is warranted.\",\n  \"wait\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const run = pm.response.json();",
                  "pm.collectionVariables.set('runId', run.id);",
                  "if (run.pending_approval) { pm.collectionVariables.set('approvalId', run.pending_approval.id); }"
                ]
